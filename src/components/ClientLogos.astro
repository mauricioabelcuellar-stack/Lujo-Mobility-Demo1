---
// Grilla de logos de empresas (placeholders): escala de grises por defecto y color al pasar el mouse.
import content from '../content.json';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';

const { empresas } = content;
---

<section class="section bg-white" aria-labelledby="clientes-titulo">
  <div class="container-lux">
    <SectionHeading id="clientes-titulo" eyebrow={empresas.eyebrow} title={empresas.titulo} tone="light" align="center" />

    <ul class="mt-16 grid grid-cols-2 border-t border-l border-ink-950/10 md:grid-cols-3 lg:mt-20 lg:grid-cols-6" data-reveal-stagger>
      {
        empresas.items.map((empresa) => (
          <li
            class="flex h-36 flex-col items-center justify-center gap-3 border-r border-b border-ink-950/10 px-4 text-center opacity-55 grayscale transition duration-700 hover:opacity-100 hover:grayscale-0 lg:h-44"
            style={`--brand:${empresa.color}`}
          >
            <Icon name={empresa.icono} size={30} strokeWidth={1.3} class="text-[var(--brand)]" />
            <span class="text-sm font-medium tracking-[0.12em] text-ink-950 uppercase">
              {empresa.nombre}
            </span>
          </li>
        ))
      }
    </ul>
    <p class="mt-8 text-center text-xs text-stone-ink">{empresas.nota}</p>
  </div>
</section>
