---
// Banda de llamada a la acción con imagen nocturna de Lima: WhatsApp y enlace a contacto.
import { Image } from 'astro:assets';
import { ArrowRight } from 'lucide-react';
import content from '../content.json';
import { getImageAsset } from '../lib/images.js';
import { routes, whatsappUrl } from '../lib/site.js';
import BrandIcon from './BrandIcon.astro';

const { cta, ui } = content;
const { message } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-ink-950">
  <Image
    src={getImageAsset(cta.imagen)}
    alt={cta.imagenAlt}
    widths={[640, 1024, 1600, 2000]}
    sizes="100vw"
    class="absolute inset-0 -z-20 h-full w-full object-cover"
  />
  <div class="absolute inset-0 -z-10 bg-ink-950/45" aria-hidden="true"></div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink-950 via-ink-950/60 to-transparent" aria-hidden="true"></div>

  <div class="container-lux py-28 lg:py-40">
    <div class="max-w-2xl" data-reveal>
      <p class="eyebrow eyebrow-line text-silver-300">{cta.eyebrow}</p>
      <h2 class="heading-lg mt-6 text-white">{cta.titulo}</h2>
      <p class="mt-6 text-lg leading-relaxed text-silver-200">{cta.descripcion}</p>
      <div class="mt-10 flex flex-col gap-4 sm:flex-row">
        <a
          href={whatsappUrl(message)}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-light"
          aria-label={`${cta.whatsapp} (${ui.nuevaPestana})`}
        >
          <BrandIcon name="whatsapp" size={18} />
          {cta.whatsapp}
        </a>
        <a href={routes.contacto} class="btn btn-outline">
          {cta.contacto}
          <ArrowRight size={18} strokeWidth={1.3} aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>
</section>
