---
// Grilla de los 7 servicios: 4 + 3 tarjetas en desktop, 2 columnas en tablet y 1 en mobile.
import { services } from '../lib/site.js';
import ServiceCard from './ServiceCard.astro';

const spans = (index) => {
  const desktop = index < 4 ? 'lg:col-span-3' : 'lg:col-span-4';
  const tablet = index === services.length - 1 ? 'md:col-span-2' : 'md:col-span-1';
  return `${tablet} ${desktop}`;
};
---

<div class="grid gap-4 md:grid-cols-2 lg:grid-cols-12 lg:gap-5" data-reveal-stagger>
  {services.map((service, index) => <ServiceCard service={service} class={spans(index)} />)}
</div>
