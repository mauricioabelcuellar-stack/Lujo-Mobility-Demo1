---
// Tarjeta de vehículo: imagen en formato uniforme sobre negro y ficha con categoría, capacidad y características.
import { Image } from 'astro:assets';
import { Briefcase, Check, Users } from 'lucide-react';
import content from '../content.json';
import { getImageAsset } from '../lib/images.js';

const { vehicle } = Astro.props;
const { ui } = content;
---

<article class="group flex h-full flex-col bg-white text-ink-950">
  <div class="relative aspect-[3/2] overflow-hidden bg-ink-950">
    <Image
      src={getImageAsset(vehicle.imagen)}
      alt={vehicle.imagenAlt}
      widths={[480, 720, 960, 1200]}
      sizes="(min-width: 768px) 50vw, 100vw"
      class="h-full w-full object-cover transition-transform duration-[1600ms] ease-[var(--ease-lux)] group-hover:scale-[1.04]"
    />
    <span class="absolute top-5 left-5 bg-ink-950/80 px-3 py-1.5 text-[0.65rem] tracking-[0.3em] text-silver-200 uppercase backdrop-blur">
      {vehicle.categoria}
    </span>
  </div>

  <div class="flex flex-1 flex-col p-7 sm:p-9">
    <p class="eyebrow text-stone-ink">{vehicle.modelo}</p>
    <h3 class="mt-3 text-3xl">{vehicle.nombre}</h3>

    <dl class="mt-7 grid grid-cols-2 gap-4 border-y border-ink-950/10 py-5 text-sm">
      <div class="flex items-center gap-3">
        <Users size={18} strokeWidth={1.3} aria-hidden="true" />
        <div>
          <dt class="sr-only">{ui.capacidad}</dt>
          <dd>{vehicle.capacidad}</dd>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <Briefcase size={18} strokeWidth={1.3} aria-hidden="true" />
        <div>
          <dt class="sr-only">{ui.equipaje}</dt>
          <dd>{vehicle.equipaje}</dd>
        </div>
      </div>
    </dl>

    <ul class="mt-6 space-y-3 text-[0.95rem] text-stone-ink">
      {
        vehicle.caracteristicas.map((feature) => (
          <li class="flex items-start gap-3">
            <Check size={16} strokeWidth={1.5} class="mt-1 shrink-0 text-ink-950" aria-hidden="true" />
            {feature}
          </li>
        ))
      }
    </ul>
  </div>
</article>
