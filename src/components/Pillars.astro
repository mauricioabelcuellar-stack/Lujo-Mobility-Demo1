---
// Pilares de la marca (seguridad, puntualidad, discreción, atención) en grilla con iconos.
import content from '../content.json';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';

const { pilares } = content;
const { tone = 'dark' } = Astro.props;
const isLight = tone === 'light';
---

<section class:list={['section', isLight ? 'bg-ivory' : 'bg-ink-950']}>
  <div class="container-lux">
    <SectionHeading eyebrow={pilares.eyebrow} title={pilares.titulo} tone={tone} />
    <ul class="mt-16 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:mt-20 lg:grid-cols-4" data-reveal-stagger>
      {
        pilares.items.map((pilar) => (
          <li class:list={['border-t pt-10', isLight ? 'border-ink-950/20' : 'border-white/15']}>
            <Icon name={pilar.icono} size={28} strokeWidth={1.1} class={isLight ? 'text-ink-950' : 'text-silver-200'} />
            <h3 class:list={['mt-8 text-2xl', isLight ? 'text-ink-950' : 'text-white']}>{pilar.titulo}</h3>
            <p class:list={['mt-4 leading-relaxed', isLight ? 'text-stone-ink' : 'text-silver-400']}>
              {pilar.descripcion}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
