---
// Tarjeta de servicio: imagen, número, icono, nombre, descripción y enlace a /servicios/[slug].
import { Image } from 'astro:assets';
import { ArrowRight } from 'lucide-react';
import content from '../content.json';
import { getImageAsset } from '../lib/images.js';
import { serviceUrl } from '../lib/site.js';
import Icon from './Icon.astro';

const { service, class: className } = Astro.props;
---

<a href={serviceUrl(service.slug)} class:list={['service-tile group', className]}>
  <Image
    src={getImageAsset(service.imagen)}
    alt=""
    widths={[480, 720, 960]}
    sizes="(min-width: 1024px) 34vw, (min-width: 768px) 50vw, 100vw"
    class="service-tile__image"
  />
  <div class="service-tile__shade" aria-hidden="true"></div>

  <div class="flex items-start justify-between">
    <span class="silver-text font-serif text-4xl leading-none" aria-hidden="true">{service.numero}</span>
    <span class="grid size-12 place-items-center rounded-full border border-white/25 text-silver-100 backdrop-blur-sm">
      <Icon name={service.icono} size={20} />
    </span>
  </div>

  <div>
    <h3 class="font-serif text-2xl leading-tight text-white sm:text-[1.7rem]">{service.nombre}</h3>
    <p class="mt-3 text-[0.95rem] leading-relaxed text-silver-300">{service.descripcion}</p>
    <span class="link-arrow mt-6 text-[0.7rem] text-white">
      {content.ui.verServicio}
      <ArrowRight size={14} strokeWidth={1.3} aria-hidden="true" />
    </span>
  </div>
</a>
