---
// Hero de la home a pantalla completa: imagen oscura con parallax sutil, título serif, CTA e indicadores inferiores.
import { Image } from 'astro:assets';
import { ArrowRight } from 'lucide-react';
import content from '../content.json';
import { getImageAsset } from '../lib/images.js';
import { routes } from '../lib/site.js';

const { inicio } = content;
const image = getImageAsset(inicio.imagen);
---

<section class="relative isolate flex min-h-[100svh] items-end overflow-hidden bg-ink-950" aria-labelledby="hero-title">
  <div class="absolute inset-0 -z-20 lg:left-[22%]" data-parallax>
    <Image
      src={image}
      alt={inicio.imagenAlt}
      widths={[640, 960, 1280, 1536]}
      sizes="(min-width: 1024px) 78vw, 100vw"
      loading="eager"
      fetchpriority="high"
      class="h-[112%] w-full object-cover object-[42%_center] lg:object-[72%_center]"
    />
  </div>

  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink-950 via-ink-950/55 to-ink-950/30 lg:hidden" aria-hidden="true">
  </div>
  <div
    class="absolute inset-0 -z-10 hidden bg-[linear-gradient(90deg,var(--color-ink-950)_0%,var(--color-ink-950)_22%,rgb(5_5_5/0.75)_40%,rgb(5_5_5/0.15)_70%,rgb(5_5_5/0.35)_100%)] lg:block"
    aria-hidden="true"
  >
  </div>
  <div class="absolute inset-x-0 bottom-0 -z-10 h-1/3 bg-gradient-to-t from-ink-950/90 to-transparent" aria-hidden="true"></div>

  <div class="container-lux relative pt-36 pb-32 sm:pb-36 lg:pb-44">
    <p class="eyebrow text-silver-200" data-hero-item>{inicio.eyebrow}</p>
    <h1
      id="hero-title"
      class="mt-6 max-w-4xl text-[clamp(2rem,9vw,2.7rem)] leading-[1] tracking-[-0.01em] text-white uppercase sm:text-6xl lg:text-7xl xl:text-[5.4rem]"
    >
      {inicio.titulo.map((line) => <span class="block" data-hero-item>{line}</span>)}
    </h1>
    <p class="mt-7 max-w-md text-lg leading-relaxed text-silver-200 sm:text-xl" data-hero-item>
      {inicio.subtitulo}
    </p>
    <div class="mt-10" data-hero-item>
      <a href={routes.contacto} class="btn btn-outline">
        {inicio.cta}
        <ArrowRight size={20} strokeWidth={1.2} aria-hidden="true" />
      </a>
    </div>
  </div>

  <div class="absolute inset-x-0 bottom-0 pb-8 sm:pb-10">
    <div class="container-lux flex items-center justify-between gap-6">
      <a
        href="#intro"
        class="inline-flex items-center gap-5 py-2 text-xs tracking-[0.2em] text-silver-300 transition-colors hover:text-white"
        aria-label={inicio.scrollIndicator.label}
      >
        <span class="scroll-line" aria-hidden="true"></span>
        <span aria-hidden="true" class="text-white">{inicio.scrollIndicator.actual}</span>
        <span aria-hidden="true">{inicio.scrollIndicator.total}</span>
      </a>
      <p class="mr-20 hidden items-center gap-6 text-[0.68rem] tracking-[0.42em] text-silver-300 uppercase md:flex lg:mr-24">
        <span class="h-px w-16 bg-white/35" aria-hidden="true"></span>
        {inicio.confidenceText}
        <span class="h-px w-16 bg-white/35" aria-hidden="true"></span>
      </p>
    </div>
  </div>
</section>
