---
// Página Contacto: canales de atención y CTA a WhatsApp. Sin formulario (se resolverá por separado).
import { Check, Clock, Mail, MapPin, Phone } from 'lucide-react';
import content from '../content.json';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import BrandIcon from '../components/BrandIcon.astro';
import { emailUrl, phoneUrl, routes, whatsappUrl } from '../lib/site.js';

const { contacto, site, seo, navigation, ui } = content;

const channels = [
  { label: contacto.telefonoLabel, value: site.telefono, href: phoneUrl, icon: Phone },
  { label: contacto.whatsappLabel, value: site.whatsappVisible, href: whatsappUrl(), brand: 'whatsapp', external: true },
  { label: contacto.emailLabel, value: site.email, href: emailUrl, icon: Mail },
  { label: contacto.horarioLabel, value: site.horario, icon: Clock },
  { label: contacto.zonaLabel, value: contacto.zona, icon: MapPin },
];
---

<Layout title={seo.contacto.title} description={seo.contacto.description}>
  <PageHero
    image={contacto.imagen}
    alt={contacto.imagenAlt}
    eyebrow={contacto.eyebrow}
    title={contacto.titulo}
    description={contacto.descripcion}
    breadcrumb={[{ label: navigation.inicio, href: routes.inicio }, { label: navigation.contacto }]}
  >
    <div class="mt-10" data-hero-item>
      <a
        href={whatsappUrl()}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-light"
        aria-label={`${contacto.ctaWhatsapp} (${ui.nuevaPestana})`}
      >
        <BrandIcon name="whatsapp" size={18} />
        {contacto.ctaWhatsapp}
      </a>
    </div>
  </PageHero>

  <section class="section bg-ivory text-ink-950" aria-labelledby="canales-titulo">
    <div class="container-lux grid gap-16 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-7">
        <h2 id="canales-titulo" class="heading-lg" data-reveal>{contacto.canalesTitulo}</h2>
        <ul class="mt-12 grid gap-px border border-ink-950/10 bg-ink-950/10 sm:grid-cols-2" data-reveal-stagger>
          {
            channels.map((channel) => {
              const Tag = channel.href ? 'a' : 'div';
              const ChannelIcon = channel.icon;
              return (
                <li class="bg-white sm:last:odd:col-span-2">
                  <Tag
                    href={channel.href}
                    target={channel.external ? '_blank' : undefined}
                    rel={channel.external ? 'noopener noreferrer' : undefined}
                    class:list={['flex h-full flex-col gap-5 p-8', channel.href && 'transition-colors duration-500 hover:bg-ink-950 hover:text-white']}
                  >
                    {channel.brand ? (
                      <BrandIcon name={channel.brand} size={22} />
                    ) : (
                      <ChannelIcon size={22} strokeWidth={1.2} aria-hidden="true" />
                    )}
                    <span>
                      <span class="eyebrow block opacity-70">{channel.label}</span>
                      <span class="mt-3 block text-lg break-words">{channel.value}</span>
                      {channel.external && <span class="sr-only">({ui.nuevaPestana})</span>}
                    </span>
                  </Tag>
                </li>
              );
            })
          }
        </ul>
      </div>

      <aside class="space-y-10 lg:col-span-5 lg:pt-4" data-reveal>
        <div class="bg-ink-950 p-8 text-silver-200 sm:p-10">
          <h2 class="text-2xl text-white">{contacto.infoTitulo}</h2>
          <ul class="mt-8 space-y-4">
            {
              contacto.infoItems.map((item) => (
                <li class="flex items-start gap-4">
                  <Check size={18} strokeWidth={1.5} class="mt-0.5 shrink-0 text-white" aria-hidden="true" />
                  {item}
                </li>
              ))
            }
          </ul>
          <a
            href={whatsappUrl()}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-light mt-10 w-full"
            aria-label={`${contacto.ctaWhatsapp} (${ui.nuevaPestana})`}
          >
            <BrandIcon name="whatsapp" size={18} />
            {contacto.ctaWhatsapp}
          </a>
          <p class="mt-4 text-sm text-silver-400">{contacto.ctaNota}</p>
        </div>
        <div class="border-l border-ink-950/30 pl-6">
          <h2 class="eyebrow text-stone-ink">{contacto.atencionTitulo}</h2>
          <p class="mt-4 text-lg leading-relaxed text-stone-ink">{contacto.atencionTexto}</p>
        </div>
      </aside>
    </div>
  </section>
</Layout>
